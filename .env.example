# Copy to .env.local (Vite loads this automatically) and fill in values
# from your Supabase project: Settings → API.
#
# Never commit real keys. The anon key is a public client key; row-level
# security in supabase/migrations/001_pepstep_sync.sql is what protects user data.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
